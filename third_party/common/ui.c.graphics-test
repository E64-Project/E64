// Draws an item's raw_text_len screen codes with the machine's character
// ROM. Reverse video is drawn here (block, then the glyph in the background
// colour) because not every ROM has reversed glyphs (the Plus/4's TED
// reverses in hardware).
static void ui_draw_raw_line(const struct menu_item *node, int x, int y,
                             int colour) {
  for (int i = 0; i < node->raw_text_len; i++) {
    uint8_t c = (uint8_t)node->name[i];
    if (c & 0x80) {
      ui_draw_rect(x, y, 8, 8, colour, 1);
      ui_draw_char_raw(c & 0x7f, x, y, BG_COLOR, NULL, 0, 1);
    } else {
      ui_draw_char_raw(c, x, y, colour, NULL, 0, 1);
    }
    x += 8;
  }
}

static int ui_row_pitch(int stack_index)
{
  if (stack_index == 0)
    return 10;

  struct menu_item *root = &menu_roots[stack_index];

  // Profile lists use a more comfortable 12-pixel row spacing.
  if (root->menu_width == 36 * 8 &&
      root->first_child != NULL &&
      (strcmp(root->first_child->name, "Select profile") == 0 ||
       strcmp(root->first_child->name, "Delete Profile") == 0))
    return 12;

  // Normal settings panels and file browsers.
  // Compact OSD dialogs remain on the 8-pixel grid.
  if (root->menu_height >= 9 * 8)
    return 10;

  return 8;
}

// Network settings use one common value column rather than placing each
// value at a different position according to its length.
static int ui_network_value_item(const struct menu_item *item) {
  /* SSID display and Scan button share an ID. Only align the display. */
  if (item->id == MENU_WIFI_SSID)
    return item->type == TEXTFIELD;

  // The main-menu status line owns its colon and uses a right-side value.
  if (item->type == READ_ONLY_HEADING &&
      strcmp(item->name, "Network Status:") == 0)
    return 0;
  switch (item->id) {
    case MENU_NETWORK_ENABLED:
    case MENU_NET_IP_MODE:
    case MENU_NET_IP_ADDRESS:
    case MENU_NET_NETMASK:
    case MENU_NET_GATEWAY:
    case MENU_NET_DNS:
    case MENU_NET_NTP_ENABLED:
    case MENU_NET_NTP_SERVER:
    case MENU_TIMEZONE_OFFSET:
    case MENU_NET_DST_ENABLED:
    case MENU_WIFI_SECURITY:
    case MENU_WIFI_COUNTRY:
    case MENU_WEBUI_ENABLED:
    case MENU_WEBUI_PIN:
      return 1;
    default:
      return item->type == BUTTON && item->disabled &&
             strcmp(item->name, "IP Address") == 0 &&
             item->displayed_value[0] != '\0';
  }
}

// Keep displayed values within the 15-character column.  In particular,
// long Wi-Fi SSIDs must never extend over the outer menu border.
static void ui_draw_network_value(const char *value, int x, int y, int colour) {
  char visible[16];
  size_t length = strlen(value);
  if (length > 15) {
    memcpy(visible, value, 14);
    visible[14] = '>';
    visible[15] = '\0';
    value = visible;
  }
  ui_draw_text(value, x, y, colour);
}

// Positions before root rows where an open section starts or ends.  These
// are pixel gaps, not selectable menu rows.
#define MAX_ROOT_SECTION_BOUNDARIES 128
static int root_section_boundaries[MAX_ROOT_SECTION_BOUNDARIES];
static int root_section_boundary_count;

static void ui_root_add_boundary(int row) {
  if (row <= 0 || root_section_boundary_count >= MAX_ROOT_SECTION_BOUNDARIES)
    return;
  if (root_section_boundary_count &&
      root_section_boundaries[root_section_boundary_count - 1] == row)
    return;
  root_section_boundaries[root_section_boundary_count++] = row;
}

static void ui_root_skip_rows(struct menu_item *node, int *row) {
  while (node != NULL) {
    ++*row;
    if (node->type == FOLDER && node->is_expanded && node->first_child)
      ui_root_skip_rows(node->first_child, row);
    node = node->next;
  }
}

static void ui_root_collect_boundaries(void) {
  root_section_boundary_count = 0;
  int row = 0;
  struct menu_item *node = menu_roots[0].first_child;
  struct menu_item *previous = NULL;
  while (node != NULL) {
    if (node->type == FOLDER && node->is_expanded && node->first_child) {
      if (previous == NULL || previous->type != DIVIDER)
        ui_root_add_boundary(row);
      ++row;
      ui_root_skip_rows(node->first_child, &row);
      if (node->next && node->next->type != DIVIDER)
        ui_root_add_boundary(row);
    } else {
      ++row;
    }
    previous = node;
    node = node->next;
  }
}

static int ui_root_boundary_pixels(int first, int last) {
  int count = 0;
  for (int i = 0; i < root_section_boundary_count; ++i)
    if (root_section_boundaries[i] > first &&
        root_section_boundaries[i] <= last)
      ++count;
  return count * 2;
}

// Keep the root's original 15-row pixel budget.  Each boundary uses two
// extra pixels, so fewer rows are visible when many folders are open.
static int ui_root_visible_bottom(int top, int total) {
  int end = top;
  while (end < total &&
         (end - top + 1) * 10 +
         ui_root_boundary_pixels(top, end) <= 150)
    ++end;
  return end;
}

static int ui_root_has_boundary(int row) {
  for (int i = 0; i < root_section_boundary_count; ++i)
    if (root_section_boundaries[i] == row)
      return 1;
  return 0;
}

// Two-pixel blue rule with one clear pixel above and below the line.
static void ui_draw_open_section_rule(struct menu_item *item, int row) {
  if (row <= menu_window_top[0] || row >= menu_window_bottom[0] ||
      !ui_root_has_boundary(row))
    return;
  int y = item->menu_top + 25 +
          (row - menu_window_top[0]) * ui_row_pitch(0) +
          ui_root_boundary_pixels(menu_window_top[0], row) - 3;
  ui_draw_rect(item->menu_left + 8, y,
               item->menu_width - 16, 2, BORDER_COLOR, 1);
}

static void ui_render_children(struct menu_item *node,
                               int stack_index, int *index, int indent) {
  struct menu_item *first = menu_roots[stack_index].first_child;
  int plain_help_text =
      stack_index != 0 && first != NULL &&
      (strcmp(first->name, "DRIVE REFERENCE") == 0 ||
       strcmp(first->name, "Steps To Enable IEEE-488 Drives") == 0);
  int fixed_top = ui_help_fixed_top(stack_index);
  int fixed_bottom = ui_help_fixed_bottom(stack_index);
  // This popup has its own optical vertical alignment within the blue plate.
  int about_contents = stack_index != 0 && first != NULL &&
      first->menu_width == 30 * 8 && first->menu_height == 10 * 8 &&
      strcmp(first->name, "C64 Enhanced Edition - R7") == 0 &&
      first->next != NULL &&
      strcmp(first->next->name, "Built on BMC64 v5.2.6") == 0;
  // Profile name popups have a blank spacer row before their title.
  int profile_name_dialog = stack_index != 0 && first != NULL &&
      first->menu_width == 25 * 8 && first->menu_height == 6 * 8 &&
      first->name[0] == '\0' && first->next != NULL &&
      (strcmp(first->next->name, "New Profile Name") == 0 ||
       strcmp(first->next->name, "Rename Current Profile") == 0);
  // This is the confirmation popup, not the Delete Profile list.
  int profile_delete_confirm = stack_index != 0 && first != NULL &&
      first->menu_width == 24 * 8 && first->menu_height == 5 * 8 &&
      strcmp(first->name, "DELETE THIS PROFILE") == 0;
  int total_rows = 0;
  if (fixed_bottom) {
    for (struct menu_item *p = first; p != NULL; p = p->next) total_rows++;
  }

  while (node != NULL) {
    node->render_index = *index;

    if (stack_index == 0 && node->type == FOLDER &&
        node->is_expanded && node->first_child != NULL)
      ui_draw_open_section_rule(node, *index);

    int selected = (*index == menu_cursor[stack_index] &&
                    !node->disabled &&
                    node->type != DIVIDER);

    int colour = node->disabled ? DISABLED_COLOR : FG_COLOR;
    if (node->type == READ_ONLY_HEADING) {
      // Section titles use the same soft light blue as the framing.
      colour = BORDER_COLOR;
    } else if (node->type == READ_ONLY_DESCRIPTION) {
      colour = READ_ONLY_DESCRIPTION_COLOR;
      // Cyan is reserved for informational popups, not all help text.
      struct menu_item *heading = menu_roots[stack_index].first_child;
      if (heading && strcmp(heading->name, "Info") == 0)
        colour = 3;
    }
    // An automatically supplied, read-only network field must remain
    // legible; unrelated disabled commands can use the darker gray.
    if (node->disabled && node->type == TEXTFIELD)
      colour = 12;

    if (selected && !plain_help_text) {
      colour = BG_COLOR;
    }

    // Reserve one character at the right of the root menu for breathing room.
    // Keep selection bars and right-aligned values
    // one character away from the right border.
    int row_right = node->menu_left + node->menu_width - 8;
    int row_left = node->menu_left +
                   (stack_index == 0 ? 8 : 0);
    int highlight_left = node->menu_left + 8;
    int network_column = stack_index == 0 &&
                         ui_network_value_item(node);
    // Fifteen cells for the longest IPv4 address, as far right as it fits.
    int network_value_x = row_right - 15 * 8;

    // Render a row
    if ((fixed_top && *index < fixed_top) ||
        (fixed_bottom && *index >= total_rows - fixed_bottom) ||
        (*index >= menu_window_top[stack_index] &&
         *index < menu_window_bottom[stack_index] &&
         (!fixed_bottom || *index < total_rows - fixed_bottom))) {
      int pitch = ui_row_pitch(stack_index);
      int y = (*index - menu_window_top[stack_index]) *
              pitch + node->menu_top;
      if (fixed_top) {
        // Keep the heading above, and the drive legend below, scrolling rows.
        y = node->menu_top + 5 +
            (*index < fixed_top ? *index * pitch :
             fixed_bottom && *index >= total_rows - fixed_bottom
                 ? (menu_window_bottom[stack_index] -
                    menu_window_top[stack_index] + fixed_top +
                    *index - (total_rows - fixed_bottom)) * pitch
                 : (*index - menu_window_top[stack_index] +
                    fixed_top) * pitch);
      }

      // Title panel plus a four-pixel gap on the root menu.
      if (stack_index == 0) {
        y += 25;
        y += ui_root_boundary_pixels(menu_window_top[0], *index);
      } else if (profile_name_dialog) {
        // Rename has slightly less room below the divider than New.
        // Raise its contents a few pixels to balance the top/bottom gaps.
        y += strcmp(first->next->name, "Rename Current Profile") == 0 ? 4 : 8;
      } else if (profile_delete_confirm) {
        // Center the title, divider and name vertically in the popup.
        y += 8;
      } else if (node->menu_width == 28 * 8 &&
                 node->menu_height == 6 * 8 &&
                 menu_roots[stack_index].first_child != NULL &&
                 (strcmp(menu_roots[stack_index].first_child->name,
                         "Reboot BMC64?") == 0 ||
                  strcmp(menu_roots[stack_index].first_child->name,
                         "Shutdown BMC64?") == 0)) {
        // Center four rows inside the taller power confirmation panel.
        y += 8;
      } else if (about_contents) {
        y += 12;
      } else if (node->menu_width == 36 * 8 &&
                 menu_roots[stack_index].first_child != NULL &&
                 (strcmp(menu_roots[stack_index].first_child->name,
                         "Select profile") == 0 ||
                  strcmp(menu_roots[stack_index].first_child->name,
                         "Delete Profile") == 0)) {
        // Keep adaptive profile popup rows clear of the top border.
        y += 6;
      } else if (node->menu_width == 30 * 8 &&
                 node->menu_height == 3 * 8 &&
                 menu_roots[stack_index].first_child != NULL &&
                 strcmp(menu_roots[stack_index].first_child->name,
                        "Profile Already Running") == 0) {
        // Center the single-line profile notification.
        y += 8;
      } else if (node->menu_width == 30 * 8 &&
                 node->menu_height == 4 * 8 &&
                 menu_roots[stack_index].first_child != NULL &&
                 menu_roots[stack_index].first_child->type ==
                     READ_ONLY_HEADING &&
                 strcmp(menu_roots[stack_index].first_child->name,
                        "Info") == 0) {
        // Compact Info dialog: keep text clear of the top border.
        y += 4;
      } else if (pitch == 10) {
        // Center the SD/USB volume selector vertically.
        struct menu_item *first =
            menu_roots[stack_index].first_child;

        if (node->menu_width == 12 * 8 &&
            node->menu_height == 10 * 8 &&
            first != NULL &&
            strcmp(first->name, "SD") == 0) {

          int count = 0;
          for (struct menu_item *item = first;
               item != NULL; item = item->next)
            count++;

          int top_pad = (node->menu_height - count * 10) / 2;
          if (top_pad < 1)
            top_pad = 1;

          y += top_pad + 1;
        } else {
          y += 5;  // Standard submenu top padding
        }
      } else if (node->menu_width == 32 * 8 &&
                 node->menu_height == 8 * 8 &&
                 node->first_child == NULL) {
        // Profile-choice dialog: title, divider, two choices.
        static const int positions[] = {8, 18, 32, 46};
        int row = *index - menu_window_top[stack_index];
        if (row >= 0 && row < 4)
          y = node->menu_top + positions[row];
      }
      if (selected) {
        if (!plain_help_text) {
          int highlight_width = row_right - highlight_left;
          if ((profile_name_dialog && node->type == TEXTFIELD &&
               (node->id == MENU_PROFILES_NEW_NAME ||
                node->id == MENU_PROFILES_RENAME_NAME)) ||
              node->id == MENU_PROFILES_DELETE_ITEM) {
            // Profile names are limited to 18 characters. Keep the bar
            // centered instead of stretching it across the popup.
            highlight_width = 18 * 8;
            highlight_left = node->menu_left +
                (node->menu_width - highlight_width) / 2;
          }
          if (profile_delete_confirm &&
              node->id == MENU_PROFILES_DELETE_CONFIRM) {
            // The highlighted profile name gets one cell of padding on
            // each side, with an 18-character maximum visible width.
            highlight_width = ui_text_width(node->name) + 16;
            if (highlight_width > 20 * 8) highlight_width = 20 * 8;
            highlight_left = node->menu_left +
                (node->menu_width - highlight_width) / 2;
          }
          if (about_contents && node->id == MENU_LICENSE) {
            highlight_width = ui_text_width("License") + 16;
            highlight_left = node->menu_left +
                (node->menu_width - highlight_width) / 2;
          }
          int profile_choice =
              stack_index != 0 &&
              node->menu_width == 32 * 8 &&
              node->menu_height == 8 * 8 &&
              pitch == 8;

          int profile_list =
              stack_index != 0 &&
              node->menu_width == 36 * 8 &&
              menu_roots[stack_index].first_child != NULL &&
              (strcmp(menu_roots[stack_index].first_child->name,
                      "Select profile") == 0 ||
               strcmp(menu_roots[stack_index].first_child->name,
                      "Delete Profile") == 0);

          int highlight_height =
              profile_list ? 10 : (profile_choice ? 10 : pitch);
          int highlight_top = y -
              ((profile_list || pitch == 10 || profile_choice) ? 1 : 0);

          if (about_contents && node->id == MENU_LICENSE) {
            ui_draw_rounded_panel(highlight_left, highlight_top,
                                  highlight_width, highlight_height,
                                  4, HILITE_COLOR);
          } else {
            ui_draw_rect(highlight_left, highlight_top,
                         highlight_width, highlight_height,
                         HILITE_COLOR, 1);
          }
        }
        menu_cursor_item[stack_index] = node;
      }

      // Special symbol drawn on left edge
      if (node->symbol) {
          ui_draw_char_raw(node->symbol,
              row_left+indent*8 +
                ((stack_index != 0 && node->symbol == 31) ? 8 : 0),
              y, colour, NULL, 0, 1);
      }

      // Sometimes, we only want to render the current item. Like when we
      // are adjusting things that affect video and we want to see the display
      // underneath the menu while we are making changes.
      if (!ui_render_current_item_only ||
          *index == menu_cursor[stack_index]) {

        if (node->raw_text_len > 0) {
          ui_draw_raw_line(node, row_left + (indent + 1) * 8, y,
                           colour);
        } else {
          int text_x = row_left + (indent + 1) * 8 +
                       ((stack_index != 0 && node->symbol == 31) ? 8 : 0);

          // Align the Wi-Fi scan button one character farther left.
          if (node->id == MENU_WIFI_SSID && node->type == BUTTON)
            text_x -= 8;

          // Center submenu headings without moving selectable items.
          if (stack_index != 0 &&
              node->type == READ_ONLY_HEADING) {
            text_x = node->menu_left +
                     (node->menu_width - ui_text_width(node->name)) / 2;
            if (strcmp(node->name, " Type   Drive Model") == 0)
              text_x = row_left + (indent + 1) * 8;
          } else if (about_contents && node->id == MENU_LICENSE) {
            text_x = node->menu_left +
                     (node->menu_width - ui_text_width(node->name)) / 2;
          } else if (node->id == MENU_PROFILES_DELETE_ITEM) {
            // Align the name with its centered 18-character selection bar.
            text_x = node->menu_left +
                     (node->menu_width - 18 * 8) / 2;
          } else if (profile_delete_confirm &&
                     node->id == MENU_PROFILES_DELETE_CONFIRM) {
            text_x = node->menu_left +
                     (node->menu_width - ui_text_width(node->name)) / 2;
          }

          // The Wi-Fi password status sits in a framed three-row area.
          // Its heading is centered horizontally and vertically in the box.
          if (stack_index != 0 &&
              node->menu_width == 42 * 8 &&
              node->menu_height == 10 * 8 &&
              node->type == READ_ONLY_HEADING &&
              (strcmp(node->name, "Password Already Set") == 0 ||
               strcmp(node->name, "Password Not Set") == 0) &&
              menu_roots[stack_index].first_child != NULL &&
              strcmp(menu_roots[stack_index].first_child->name,
                     "Wi-Fi Password") == 0) {
            ui_draw_rect(node->menu_left + 12, y - 7,
                         node->menu_width - 24, 24, BORDER_COLOR, 0);
          }

          if (stack_index != 0 &&
              node->menu_width == 30 * 8 &&
              node->menu_height == 3 * 8 &&
              strcmp(node->name, "Profile Already Running") == 0) {
            // Center this notification within its panel.
            text_x = node->menu_left +
                     (node->menu_width - (int)strlen(node->name) * 8) / 2;
          }

          ui_draw_c64_menu_text(
             node->name, text_x, y, colour,
             node->type == READ_ONLY_HEADING &&
             strcmp(node->name, "Network Status:") != 0);
        }

        if (network_column) {
          ui_draw_text(": ", network_value_x - 16, y, colour);
        }

        if (node->type == READ_ONLY_HEADING &&
          node->displayed_value[0] != '\0') {
          if (network_column)
            ui_draw_network_value(node->displayed_value,
                                  network_value_x, y, colour);
          else
            ui_draw_text(node->displayed_value,
                   row_right -
                     ui_text_width(node->displayed_value) -
                     (strcmp(node->name, "Network Status:") == 0 ? 8 : 0),
                   y, colour);
        } else if (node->type == FOLDER) {
          if (node->is_expanded)
            ui_draw_text("-", row_left + (indent)*8, y, colour);
          else
            ui_draw_text("+", row_left + (indent)*8, y, colour);
          // A folder can show its current setting at the right edge,
          // aligned with ranges, toggles and multiple-choice values.
          // An empty displayed_value retains the existing folder layout.
          if (node->displayed_value[0] != '\0') {
            ui_draw_text(node->displayed_value,
                         row_right - ui_text_width(node->displayed_value),
                         y, colour);
          }
        } else if (node->type == TOGGLE) {
          if (node->value) {
            if (node->custom_toggle_label[1][0] == '\0') {
               ui_draw_text("On",
                         network_column ? network_value_x :
                         row_right - ui_text_width("On"), y, colour);
            } else {
               const char *v = node->custom_toggle_label[1];
               ui_draw_text(v, network_column ? network_value_x :
                            row_right - ui_text_width(v), y, colour);
            }
          } else {
            if (node->custom_toggle_label[0][0] == '\0') {
               ui_draw_text("Off", network_column ? network_value_x :
                            row_right - ui_text_width("Off"), y, colour);
            } else {
               const char *v = node->custom_toggle_label[0];
               ui_draw_text(v, network_column ? network_value_x :
                            row_right - ui_text_width(v), y, colour);
            }
          }
        } else if (node->type == CHECKBOX) {
          if (node->value)
            ui_draw_text("True", row_right -
                                     ui_text_width("True"),
                         y, colour);
          else
            ui_draw_text("False", row_right -
                                      ui_text_width("False"),
                         y, colour);
        } else if (node->type == RANGE) {
          if (node->divisor == 1) {
             sprintf(node->scratch, "%d", node->value);
          } else {
             // TODO: Don't assume 3 decimal places. Use divisor.
             sprintf(node->scratch, "%.3f",
                (float)node->value / (float)node->divisor);
          }
          ui_draw_text(node->scratch, row_right -
                                          ui_text_width(node->scratch),
                       y, colour);
        } else if (node->type == MULTIPLE_CHOICE) {
          const char *v = node->choices[node->value];
          if (network_column)
            ui_draw_network_value(v, network_value_x, y, colour);
          else
            ui_draw_text(v, row_right - ui_text_width(v), y, colour);
        } else if (node->type == DIVIDER) {
          ui_draw_rect(node->menu_left + 8, y + 3,
                       node->menu_width - 16, 2, BORDER_COLOR, 1);
        } else if (node->type == BUTTON) {
          char *dsp_string = get_button_display_str(node);
          if (network_column)
            ui_draw_network_value(dsp_string, network_value_x, y, colour);
          else
            ui_draw_text(dsp_string, row_right -
                         ui_text_width(dsp_string), y, colour);
        } else if (node->type == TEXTFIELD) {
          const char *display_text = node->str_value;
          if (node->textfield_masked) {
            size_t length = strlen(node->str_value);
            memset(node->scratch, '*', length);
            node->scratch[length] = '\0';
            display_text = node->scratch;
          }
          int value_x = row_left + ui_text_width(node->name) + 8;
          // Address fields share a fixed column: reserve 15 characters for
          // 255.255.255.255 plus one cell for the editing cursor.  This
          // keeps short addresses from colliding with their labels.
          int address_field = ui_is_network_address_field(node->id);
          if (network_column || address_field) {
            value_x = network_value_x;
          } else if (node->textfield_right_aligned) {
            value_x = row_right -
                      ui_text_width(display_text);
          } else if (profile_name_dialog &&
                     (node->id == MENU_PROFILES_NEW_NAME ||
                      node->id == MENU_PROFILES_RENAME_NAME)) {
            // Left-align entered text within the centered selection bar.
            value_x = node->menu_left +
                      (node->menu_width - 18 * 8) / 2;
          }
          // Draw text cursor only on the currently selected text field.
          if (*index == menu_cursor[stack_index]) {
#if BMC64_NEW_KEYBOARD_INPUT
            int cursor_cells = node->value;
            if (!node->textfield_masked) {
              cursor_cells = 0;
              const char *cursor = node->str_value;
              const char *end = cursor + node->value;
              while (cursor < end) {
                uint32_t cp;
                cursor = ui_utf8_next(cursor, &cp);
                cursor_cells++;
              }
            }
            int cursor_x = value_x + cursor_cells * 8;
            int max_cursor_x = row_right - 8;
            if (cursor_x > max_cursor_x) {
              cursor_x = max_cursor_x;
            }
            ui_draw_rect(cursor_x, y, 8, 8, BORDER_COLOR, 1);
#else
            int cursor_x = value_x + node->value * 8;
            int max_cursor_x = row_right - 8;
            if (cursor_x > max_cursor_x) {
              cursor_x = max_cursor_x;
            }
            ui_draw_rect(cursor_x, y, 8, 8, BORDER_COLOR, 1);
#endif
          }
          if (network_column)
            ui_draw_network_value(display_text, value_x, y, colour);
          else
            ui_draw_text(display_text, value_x, y, colour);
        }
      }
    }

    *index = *index + 1;
    if (node->type == FOLDER && node->is_expanded &&
        node->first_child != NULL) {
      ui_render_children(node->first_child, stack_index, index, indent + 1);
      if (stack_index == 0 && node->next != NULL &&
          node->next->type != DIVIDER)
        ui_draw_open_section_rule(node, *index);
    }
    node = node->next;
  }
}

// Make the UI layer fully transparent in preparation for an OSD to
// be displayed.
void ui_make_transparent(void) {
  memset(ui_fb, TRANSPARENT_COLOR, ui_fb_h * ui_fb_pitch);
}

static void ui_draw_shadow_text(const char* txt, int *x, int *y, int col) {
  ui_draw_text(txt, *x+1, *y, 0);
  ui_draw_text(txt, *x-1, *y, 0);
  ui_draw_text(txt, *x, *y+1, 0);
  ui_draw_text(txt, *x, *y-1, 0);
  ui_draw_text(txt, *x, *y, col);
  *x = *x + strlen(txt) *8;
}

static void ui_traverse(void);

void ui_render_now(int menu_stack_index) {
  if (ui_color_comparison_active) {
    ui_render_color_comparison();
    return;
  }
  int index = 0;
  int indent = 0;

  // The UI frame buffer is allocated lazily by ui_geometry_changed(). If
  // something tries to render before that has happened (e.g. an early
  // ui_error()), there is nothing to draw into.
  if (ui_fb == NULL) {
    return;
  }

  if (menu_stack_index == -1) {
    menu_stack_index = current_menu;
    // Keep single-menu refreshes opaque too.
    memset(ui_fb, BG_COLOR, ui_fb_h * ui_fb_pitch);
  }

  struct menu_item *ptr = menu_roots[menu_stack_index].first_child;
  int fixed_top = ui_help_fixed_top(menu_stack_index);
  int fixed_bottom = ui_help_fixed_bottom(menu_stack_index);
  // Recalculate the expanded menu and reveal its current selection before
  // drawing.  A folder opening/closing can change row indices abruptly.
  if (menu_stack_index == current_menu && !fixed_top)
    ui_traverse();
  if (fixed_top && menu_window_top[menu_stack_index] == 0) {
    menu_window_top[menu_stack_index] = fixed_top;
    menu_window_bottom[menu_stack_index] -= fixed_bottom;
  }

  // Dedicated About-screen identification plate.
  int is_about =
      menu_stack_index != 0 &&
      !ui_transparent &&
      ptr != NULL &&
      ptr->next != NULL &&
      ptr->next->next != NULL &&
      ptr->menu_width == 30 * 8 &&
      ptr->menu_height == 10 * 8 &&
      // Match the exact About identity and geometry so other popups
      // retain their own framing and spacing.
      strcmp(ptr->name, "C64 Enhanced Edition - R7") == 0 &&
      strcmp(ptr->next->name,
             "Built on BMC64 v5.2.6") == 0 &&
      strcmp(ptr->next->next->name,
             "VICE 3.3 / Circle") == 0;

  // Root menu: authentic C64 character frame, with existing header/footer.
  // Child menus retain their original geometry and rendering.
  if (is_about) {
    // About draws its own rounded frame below.
  } else if (menu_stack_index == 0 && !ui_transparent) {
    int left = ptr->menu_left;
    int top = ptr->menu_top;
    int width = ptr->menu_width;
    int height = ptr->menu_height;
    // Temporary diagnostic marker: confirms which ui.c is running on the Pi.
    const char *title = "E64 V1 GRAPHICS TEST";
    const char *footer = "  CRSR NAV    RETURN SELECT    ";
    const char *suffix = " EXIT  ";

    // Leave the contents and panels undisturbed. Frame sits one character
    // outside the menu bounds, and uses the real graphics character ROM.
    ui_draw_c64_menu_frame(left - 8, top - 8,
                           width + 16, height + 16, BORDER_COLOR);

    // Square orange header; C64 black lettering stays centered.
    ui_draw_c64_rounded_banner(left + 3, top + 2, width - 6, 16, 8);
    // Draw the title with the original C64 uppercase/graphics font.
    // Fall back to the common font until CHARGEN is initialized.
    int title_x = left + (width - ui_text_width(title)) / 2;
    int title_y = top + 6;

    if (raw_video_font != NULL) {
      for (int i = 0; title[i] != '\0'; ++i) {
        unsigned char c = (unsigned char)title[i];
        unsigned char glyph = c;

        // Uppercase letters occupy screen codes 1 through 26.
        if (c >= 'A' && c <= 'Z') {
          glyph = c - 'A' + 1;
        }

        ui_draw_char_raw((char)glyph,
                         title_x + i * 8, title_y,
                         BG_COLOR, NULL, 0, 1);
      }
    } else {
      ui_draw_text(title, title_x, title_y, BG_COLOR);
    }

    // 20-pixel footer gives the 8-pixel font 6 pixels above and below.
    int footer_top = top + height - 20;
    // Square footer, in the original banner color.
    ui_draw_c64_rounded_banner(left + 3, footer_top + 2,
                               width - 6, 16, 8);
    int total_width = ui_text_width(footer) + 8 + ui_text_width(suffix);
    int x = left + (width - total_width) / 2;
    int y = footer_top + 6;
    ui_draw_text(footer, x, y, BG_COLOR);
    x += ui_text_width(footer);
    if (raw_video_font) {
      ui_draw_char_raw(0x1F, x, y, BG_COLOR,
                       NULL, 0, 1);
    }
    ui_draw_text(suffix, x + 8, y, BG_COLOR);
  } else {
    if (!ui_transparent) {
      // Dark surround, light-blue outline, and navy interior.
      // Match the layered appearance of the About screen.
      ui_draw_rounded_panel(ptr->menu_left - 4, ptr->menu_top - 4,
                            ptr->menu_width + 8, ptr->menu_height + 8,
                            6, BG_COLOR);
      ui_draw_rounded_panel(ptr->menu_left - 1, ptr->menu_top - 1,
                            ptr->menu_width + 2, ptr->menu_height + 2,
                            6, BORDER_COLOR);
      ui_draw_rounded_panel(ptr->menu_left, ptr->menu_top,
                            ptr->menu_width, ptr->menu_height,
                            6, BG_COLOR);

      // Power confirmations share About's royal-blue inner plate.
      if (menu_stack_index != 0 && ptr->next != NULL &&
          ptr->menu_width == 28 * 8 && ptr->menu_height == 6 * 8 &&
          (strcmp(ptr->name, "Reboot BMC64?") == 0 ||
           strcmp(ptr->name, "Shutdown BMC64?") == 0)) {
        ui_draw_rounded_panel(ptr->menu_left + 5,
                              ptr->menu_top + 5,
                              ptr->menu_width - 10,
                              ptr->menu_height - 10,
                              6, 27);
      }
    } else {
      // Preserve transparent OSD behavior.
      ui_draw_rect(ptr->menu_left - 1, ptr->menu_top - 1,
                   ptr->menu_width + 2, ptr->menu_height + 2,
                   BORDER_COLOR, 0);
    }
  }

  // The About screen is a self-contained rounded identification plate.
  if (is_about) {
    int x = ptr->menu_left;
    int y = ptr->menu_top;
    int w = ptr->menu_width;
    int h = ptr->menu_height;

    // Outer midnight-blue surround: 8 pixels.
    ui_draw_rounded_panel(x - 8, y - 8, w + 16, h + 16,
                          9, BG_COLOR);

    // Bright-blue rounded outer outline.
    ui_draw_rounded_panel(x, y, w, h,
                          10, 26);

    // Midnight-blue inner frame.
    ui_draw_rounded_panel(x + 1, y + 1, w - 2, h - 2,
                          9, BG_COLOR);

    // Bright-blue identification panel with rounded corners.
    ui_draw_rounded_panel(x + 6, y + 6, w - 12, h - 12,
                          8, 27);

    // Render every row normally so the License selection remains usable.
    // Headings are centered by the submenu renderer.
    ui_render_children(ptr, menu_stack_index, &index, indent);
  } else {
    ui_render_children(ptr, menu_stack_index, &index, indent);
  }

  max_index[menu_stack_index] = index;
  if (fixed_top) {
    // A visible thumb indicates that the instructions can be scrolled.
    int visible = menu_window_bottom[menu_stack_index] -
                  menu_window_top[menu_stack_index];
    if (index > visible + fixed_top + fixed_bottom) {
      int x = ptr->menu_left + ptr->menu_width - 6;
      int y = ptr->menu_top + 7 + fixed_top * 10;
      int track_h = ptr->menu_height - 16 -
                    (fixed_top + fixed_bottom) * 10;
      int thumb_h = track_h * visible /
                    (index - fixed_top - fixed_bottom);
      if (thumb_h < 12) thumb_h = 12;
      int max_start = index - fixed_bottom - visible;
      int position = menu_window_top[menu_stack_index] - fixed_top;
      int travel = track_h - thumb_h;
      if (position > max_start - fixed_top)
        position = max_start - fixed_top;
      ui_draw_rect(x, y, 3, track_h, BORDER_COLOR, 1);
      ui_draw_rect(x, y + position * travel / (max_start - fixed_top),
                   3, thumb_h, HILITE_COLOR, 1);
    }
  }

  if (menu_cursor[menu_stack_index] >= max_index[menu_stack_index]) {
    menu_cursor[menu_stack_index] = max_index[menu_stack_index] - 1;
    cursor_pos_updated();
  }

  // Reveal dimensions in top left corner
  if (ui_transparent && ui_transparent_layer >= 0) {
    char str1[32];
    char str2[32];
    int dpx, dpy, fbw, fbh, dw, dh, sw, sh;

    // We're drawing into the UI layer so get it's fb dims.
    circle_get_fbl_dimensions(FB_LAYER_UI,
                              &dpx, &dpy,
                              &fbw, &fbh,
                              &sw, &sh,
                              &dw, &dh);

    // We can use the 1st display canvas info because our UI layer
    // mirrors it's dimensions all the time.
    int cx = canvas_state[VIC_INDEX].left + sw / 2 - 18 * 8 / 2;
    int cy = canvas_state[VIC_INDEX].top + sh / 2 - 7 * 10 / 2;

    // Now get info about the layer we are djusting
    circle_get_fbl_dimensions(ui_transparent_layer,
                              &dpx, &dpy,
                              &fbw, &fbh,
                              &sw, &sh,
                              &dw, &dh);

    int qx = cx;
    int qy = cy;

    sprintf (str1,"Display: %dx%d", dpx, dpy);
    ui_draw_shadow_text(str1, &qx, &qy, 1);

    qx = cx; qy+=10;
    // Unscaled frame buffer
    sprintf (str1, "FB: %d x %d", sw, sh);
    ui_draw_shadow_text(str1, &qx, &qy, 1);
    qx = qx + 10;

    // Scaled frame buffer. Show green dimension if it is
    // an even multiple of the unscaled frame buffer.
    qx = cx; qy+=10;
    sprintf (str1, "%d", dw);
    sprintf (str2, "%d", dh);
    ui_draw_shadow_text("SFB:", &qx, &qy, 1);
    qx = qx + 8;
    ui_draw_shadow_text(str1, &qx, &qy, dw % sw == 0 ? 5 : 1);
    ui_draw_shadow_text("x", &qx, &qy, 1);
    ui_draw_shadow_text(str2, &qx, &qy, dh % sh == 0 ? 5 : 1);
    qx = qx + 8;
    if (dw % sw == 0) {
       sprintf (str1, "x%d,", dw/sw);
       ui_draw_shadow_text(str1, &qx, &qy, 5);
    } else {
       ui_draw_shadow_text("*", &qx, &qy, 1);
    }
    if (dh % sh == 0) {
       sprintf (str1, "x%d", dh/sh);
       ui_draw_shadow_text(str1, &qx, &qy, 5);
    } else {
       ui_draw_shadow_text("*", &qx, &qy, 1);
    }

    qx = cx; qy+=20;
    ui_draw_shadow_text("Use , and . for", &qx, &qy, 1);
    qx = cx; qy+=10;
    ui_draw_shadow_text("-/+1 increments.", &qx, &qy, 1);
  }
}

// This function will traverse recursively all nodes in the node list
// starting at 'node'.  It fills in the render_index for each node as it
// goes and records the node that matches the current cursor index into
// menu_cursor_item.  No rendering is done here.  It used when
// we need to find the node matching the cursor position, taking into
// account all items that have been expanded/contracted.
static void ui_traverse_children(struct menu_item *node, int *index) {
  while (node != NULL) {
    node->render_index = *index;

    if (*index == menu_cursor[current_menu])
      menu_cursor_item[current_menu] = node;

    *index = *index + 1;
    if (node->type == FOLDER && node->is_expanded &&
        node->first_child != NULL) {
      ui_traverse_children(node->first_child, index);
    }
    node = node->next;
  }
}

// This function will traverse recursively all child nodes in the current
// active menu. See ui_traverse_child for more details on when this
// is useful.  It also records the max index for the current menu taking
// into account all items that have been expanded/contracted.
static void ui_traverse(void) {
  int index = 0;
  struct menu_item *ptr = menu_roots[current_menu].first_child;

  ui_traverse_children(ptr, &index);

  max_index[current_menu] = index;

  if (index <= 0)
    return;

  if (menu_cursor[current_menu] >= max_index[current_menu]) {
    menu_cursor[current_menu] = max_index[current_menu] - 1;
    cursor_pos_updated();
  }

  // A collapsed folder may leave the cursor on a divider/disabled row.
  if (!ui_cursor_is_selectable(menu_cursor[current_menu])) {
    int next = menu_cursor[current_menu];
    while (next < index && !ui_cursor_is_selectable(next)) next++;
    if (next == index) {
      next = menu_cursor[current_menu];
      while (next > 0 && !ui_cursor_is_selectable(next)) next--;
    }
    if (ui_cursor_is_selectable(next))
      menu_cursor[current_menu] = next;
  }

  if (current_menu == 0) {
    ui_root_collect_boundaries();
    int top = menu_window_top[0];
    if (menu_cursor[0] < top) top = menu_cursor[0];
    if (top < 0) top = 0;
    int end = ui_root_visible_bottom(top, index);
    while (menu_cursor[0] >= end && top < menu_cursor[0]) {
      ++top;
      end = ui_root_visible_bottom(top, index);
    }
    menu_window_top[0] = top;
    menu_window_bottom[0] = end;
    return;
  }

  // Preserve the window's height, but keep the selected row on-screen.
  int visible = menu_window_bottom[current_menu] -
                menu_window_top[current_menu];
  if (visible < 1) visible = 1;
  if (menu_cursor[current_menu] < menu_window_top[current_menu]) {
    menu_window_top[current_menu] = menu_cursor[current_menu];
  } else if (menu_cursor[current_menu] >= menu_window_bottom[current_menu]) {
    menu_window_top[current_menu] = menu_cursor[current_menu] - visible + 1;
  }
  int max_top = index - visible;
  if (max_top < 0) max_top = 0;
  if (menu_window_top[current_menu] > max_top)
    menu_window_top[current_menu] = max_top;
  if (menu_window_top[current_menu] < 0)
    menu_window_top[current_menu] = 0;
  menu_window_bottom[current_menu] = menu_window_top[current_menu] + visible;
}

static void ui_clear_child_menu(struct menu_item *node) {
  if (node != NULL && node->type == FOLDER) {
    ui_clear_child_menu(node->first_child);
  }

  while (node != NULL) {
    struct menu_item *next = node->next;
    free(node);
    node = next;
  }
}

static void ui_clear_menu(int menu_index) {
  struct menu_item *node = &menu_roots[menu_index];
  ui_clear_child_menu(node->first_child);
  node->first_child = NULL;
}

struct menu_item *ui_pop_menu(void) {
  struct menu_item *menu_to_pop = &menu_roots[current_menu];

  ui_clear_menu(current_menu);
  current_menu--;

  if (current_menu < 0) {
    printf("FATAL ERROR: tried to pop last menu\n");
    return NULL;
  }

  if (menu_to_pop->on_popped_off) {
    // Notify pop happened (new_root/old_root)
    menu_to_pop->on_popped_off(&menu_roots[current_menu], menu_to_pop);
  }

  if (menu_roots[current_menu].on_popped_to) {
    // Notify pop happened (new_root/old_root)
    menu_roots[current_menu].on_popped_to(
        &menu_roots[current_menu], menu_to_pop);
  }

  return &menu_roots[current_menu];
}

// left + border_w brings us to the left of gfx area
// then we center the menu width inside the gfx_w area
static int calc_root_menu_left() {
   return
       canvas_state[VIC_INDEX].left +
          canvas_state[VIC_INDEX].border_w +
             canvas_state[VIC_INDEX].gfx_w / 2 -
                menu_width_chars * 8 / 2;
}

// top + border_h brings us to the top of the gfx area
// then we center the menu height inside the gfx_h area
// BUT must take into account raster_skip since we don't
// double the height of the UI frame buffer like we do
// the main display.
static int calc_root_menu_top() {
   int raster_skip = canvas_state[VIC_INDEX].raster_skip;

   int ui_top = canvas_state[VIC_INDEX].first_displayed_line +
       canvas_state[VIC_INDEX].max_border_h / raster_skip;

   return ui_top + canvas_state[VIC_INDEX].gfx_h / 2 /
                      canvas_state[VIC_INDEX].raster_skip -
                         menu_height_chars * 8 / 2;
}

struct menu_item *ui_push_menu(int w_chars, int h_chars) {

  int menu_width = w_chars * 8;
  int menu_height = h_chars * 8;
  if (w_chars < 0)
    menu_width = menu_width_chars * 8;
  if (h_chars < 0)
    menu_height = menu_height_chars * 8;

  current_menu++;
  if (current_menu >= NUM_MENU_ROOTS) {
    printf("FATAL ERROR: tried to push menu beyond NUM_MENU_ROOTS\n");
    return NULL;
  }
  ui_clear_menu(current_menu);

  // Client must set callback on each push so clear here.
  menu_roots[current_menu].on_value_changed = NULL;
  menu_roots[current_menu].on_popped_off = NULL;
  menu_roots[current_menu].on_popped_to = NULL;

  // Set dimensions
  menu_roots[current_menu].menu_width = menu_width;
  menu_roots[current_menu].menu_height = menu_height;

  if (w_chars == -2) {
    menu_roots[current_menu].menu_left = calc_root_menu_left();
  } else if (w_chars == -1) {
    // Inherit the root menu's left
    menu_roots[current_menu].menu_left = menu_roots[0].menu_left;
  } else {
    // Center this smaller menu inside the bounds of the root
    menu_roots[current_menu].menu_left =
       menu_roots[0].menu_left + (menu_roots[0].menu_width - menu_width) / 2;
  }

  if (h_chars == -2) {
    menu_roots[current_menu].menu_top = calc_root_menu_top();
  } else if (h_chars == -1) {
    // Inherit the root menu's top
    menu_roots[current_menu].menu_top = menu_roots[0].menu_top;
  } else {
    // Center this smaller menu inside the bounds of the root
    menu_roots[current_menu].menu_top =
       menu_roots[0].menu_top + (menu_roots[0].menu_height - menu_height) / 2;
  }

  menu_cursor[current_menu] = 0;
  menu_window_top[current_menu] = 0;
  if (h_chars < 0) {
     menu_window_bottom[current_menu] =
         (current_menu == 0) ? 15 :
         (ui_row_pitch(current_menu) == 10 ?
          (menu_roots[current_menu].menu_height - 8) / 10 :
          menu_height_chars);
  } else {
     menu_window_bottom[current_menu] =
         (current_menu == 0) ? 15 :
         (ui_row_pitch(current_menu) == 10 ?
          (menu_roots[current_menu].menu_height - 8) / 10 :
          h_chars);
  }

  return &menu_roots[current_menu];
}

